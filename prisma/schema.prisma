// Prisma schema for Anfragen.Business
// Handwerksbetriebe empfangen Kundenanfragen von ihrer Website, verteilen
// sie im Dashboard an Mitarbeiter und benachrichtigen den Kunden automatisch.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum RequestStatus {
  NEU
  ZUGEWIESEN
  IN_BEARBEITUNG
  ERLEDIGT
  STORNIERT
}

enum Urgency {
  NORMAL
  DRINGEND
}

enum NotificationChannel {
  EMAIL
}

enum RequestSource {
  FORMULAR
  EMAIL
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optionale Anbindung eines bestehenden E-Mail-Postfachs (z. B. das
  // Postfach, an das das alte Kontaktformular der Betriebs-Website sendet).
  // Eingehende Mails werden per IMAP abgeholt und als Anfragen importiert.
  imapEnabled        Boolean   @default(false)
  imapHost           String?
  imapPort           Int       @default(993)
  imapSecure         Boolean   @default(true)
  imapUser           String?
  imapPass           String?
  imapFolder         String    @default("INBOX")
  lastEmailSyncAt    DateTime?
  lastEmailSyncError String?

  users    User[]
  requests Request[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  // Null, solange eine Einladung noch nicht angenommen wurde.
  passwordHash String?
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Einladungslink, über den der Betrieb sein Passwort selbst festlegt.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  assignedRequests Request[]     @relation("AssignedTo")
  statusEvents     StatusEvent[]
}

model Request {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerName  String
  customerEmail String
  customerPhone String?
  address       String?
  category      String
  description   String
  urgency       Urgency       @default(NORMAL)
  status        RequestStatus @default(NEU)
  source        RequestSource @default(FORMULAR)

  // Message-ID der Quell-E-Mail, verhindert doppelten Import.
  externalMessageId String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents  StatusEvent[]
  notifications Notification[]

  @@index([businessId, status])
  @@unique([businessId, externalMessageId])
}

model StatusEvent {
  id        String        @id @default(cuid())
  requestId String
  request   Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    RequestStatus
  message   String?
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id])
  createdAt DateTime      @default(now())
}

model Notification {
  id        String              @id @default(cuid())
  requestId String
  request   Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(EMAIL)
  recipient String
  subject   String
  body      String
  success   Boolean             @default(true)
  simulated Boolean             @default(false)
  createdAt DateTime            @default(now())
}
